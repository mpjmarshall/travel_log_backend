{{define "content" -}}
<h1>Overview</h1>
<div class="cards">
{{range .Cards}}
  <div class="card"><div class="label">{{.Label}}</div><div class="value">{{.Value}}</div></div>
{{end}}
</div>
{{if .Failed}}<p class="warn">The overview could not be read.</p>{{end}}
<h2>Recent sign-ins</h2>
{{template "sessiontable" .}}
{{- end}}
