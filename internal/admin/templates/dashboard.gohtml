{{define "content" -}}
<h1>Overview</h1>
<div class="cards">
{{range .Cards}}
  <div class="card"><div class="label">{{.Label}}</div><div class="value">{{.Value}}</div></div>
{{end}}
</div>
{{if .Sessions}}
<h2>Recent sign-ins</h2>
<table>
<thead><tr><th>Traveller</th><th>Signed in</th><th>Last used</th></tr></thead>
<tbody>
{{range .Sessions}}
  <tr><td>{{.Email}}</td><td>{{.CreatedAt}}</td><td>{{.LastUsedAt}}</td></tr>
{{end}}
</tbody>
</table>
{{end}}
{{- end}}
