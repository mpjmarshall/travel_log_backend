{{define "content" -}}
{{if .Error}}<p class="warn">{{.Error}}</p>{{end}}
{{if .Traveller}}
{{with .Traveller}}
<h1>{{.Email}}</h1>
<p class="note">{{if .Name}}{{.Name}}{{else}}No name set{{end}} · joined
{{.CreatedAt.Format "2 Jan 2006"}} · logbook version {{.LogbookVersion}}</p>
<div class="cards">
  <div class="card"><div class="label">Trips</div><div class="value">{{.Trips}}</div></div>
  <div class="card"><div class="label">Cities</div><div class="value">{{.Cities}}</div></div>
  <div class="card"><div class="label">Places</div><div class="value">{{.Places}}</div></div>
  <div class="card"><div class="label">Visits</div><div class="value">{{.Visits}}</div></div>
  <div class="card"><div class="label">Photos</div><div class="value">{{.Photos}}</div></div>
  <div class="card"><div class="label">Walks</div><div class="value">{{.Walks}}</div></div>
</div>
{{end}}
<div class="cards">
  <div class="card"><div class="label">Storage</div><div class="value">{{.Storage}}</div></div>
</div>
<h2>Name</h2>
<form hx-post="/admin/travellers/{{.Traveller.ID}}/name" hx-target="body" class="pager">
  <input type="text" name="name" value="{{.Traveller.Name}}" placeholder="Their name">
  <button type="submit">Rename</button>
</form>
<h2>Sessions</h2>
{{template "sessiontable" .}}
<h2>Delete</h2>
<p class="note">This removes {{.Traveller.Email}} and everything of theirs:
{{plural .Traveller.Trips "trip"}}, {{plural .Traveller.Photos "photo"}},
{{plural .Traveller.Places "place"}}, {{plural .Traveller.Walks "walk"}}, and their
{{.Storage}} of pictures. It cannot be undone.</p>
<form hx-post="/admin/travellers/{{.Traveller.ID}}/delete" hx-target="body" class="pager">
  <input type="text" name="email" placeholder="Type {{.Traveller.Email}} to confirm"
         autocomplete="off">
  <button class="danger" type="submit">Delete this traveller</button>
</form>
{{else}}
<h1>Not found</h1>
<p class="note">No traveller with that id.</p>
{{end}}
{{- end}}
