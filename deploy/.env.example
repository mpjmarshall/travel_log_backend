# Copy to deploy/.env to override. The stack comes up with no .env at all —
# every variable in deploy/docker-compose.yml carries a default — so this file
# is documentation of the knobs, not a prerequisite.
#
# deploy/.env is git-ignored. Nothing here is a real secret; the local-only
# target (DEC-21) is why the defaults are guessable, and why the published
# ports are bound to 127.0.0.1.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=travellog
POSTGRES_PASSWORD=travellog
POSTGRES_DB=travellog

# The HOST port the database is published on. 5434 and not 5432 or 5433: on
# this machine 5432 is a developer Postgres and 5433 is an unrelated Docker
# container. Published only so host-run store tests can reach it through
# TEST_DATABASE_URL; the api container never uses it, and a deploy publishes
# nothing here. Change it freely — it is a fact about one machine.
POSTGRES_PORT=5434

# --- API --------------------------------------------------------------------
# The HOST port the api is published on. The container always listens on 8080.
API_PORT=8080

# Read by internal/config from VS2. config.Load reports every missing one at
# once rather than failing on the first.
LOG_LEVEL=info
DB_MAX_OPEN_CONNS=8
DB_MAX_IDLE_CONNS=4
AUTH_RATE_LIMIT_PER_MIN=10

# The AUTHENTICATED ceiling, per TRAVELLER rather than per address. It is a
# separate knob from the one above because the two bound different things: that
# one bounds unauthenticated Argon2 work and is deliberately low, and this one
# bounds a STOLEN TOKEN against a 30-day session TTL with no revocation surface.
# So it is set high enough that no honest client meets it — a phone syncing a
# whole log is one read and a handful of writes — and low enough that a token
# somebody else is holding cannot read the log all day.
#
# UNTUNED against real client traffic, like the two below it. 600 a minute is
# ten a second sustained, with a burst of 600.
TRAVELLER_RATE_LIMIT_PER_MIN=600

# THE PUBLIC READ'S CEILING, per ADDRESS, on the one route in this API that
# carries no identity at all (PD-09). It is a THIRD knob rather than a reuse of
# either above: `GET /l/{token}` is unauthenticated but is not a credential
# attempt, so under the old derivation it would have inherited
# AUTH_RATE_LIMIT_PER_MIN — a 10/min CREDENTIAL budget — from the SAME bucket
# instance as register and sign-in, and one person browsing a shared trip would
# lock everybody out of signing in.
#
# UNTUNED, like the three above it. 120 a minute is two a second sustained,
# which is generous for a page a human reads and mean for a script enumerating
# twelve-character tokens.
#
# THE HONEST SENTENCE: this does not bind behind a proxy. httpx.ClientKey keys
# on RemoteAddr, so the moment something sits in front of this server every
# request arrives from one address and this becomes one bucket for the whole
# internet. Caddy is deferred to the next slice and so is X-Forwarded-For.
PUBLIC_RATE_LIMIT_PER_MIN=120

# THE PER-REQUEST BOUND (DEC-96). How long a HANDLER may take, which is not the
# same knob as how long the RESPONSE may take to reach a client on a train —
# that one is cmd/api's `writeTimeout`, 60s, and is not configurable.
#
# It is a Go duration and not a number of seconds, deliberately: a bare `15` is
# a value whose unit lives only in a comment, and time.ParseDuration refuses it
# rather than reading it as fifteen nanoseconds. Refused below 1s (one Argon2id
# hash at 64 MiB does not finish inside it, so every sign-in would answer 503)
# and above 60s (the write deadline; a handler allowed to outlive it has its
# work discarded underneath it).
#
# THE SAME NUMBER GOES ON THE DATABASE SESSION as `statement_timeout`, so a
# query that will never come back is given up by the server as well as by the
# handler.
REQUEST_TIMEOUT=15s

# UNTUNED (DEC-21). Argon2id costs 64 MiB per concurrent login, and
# DB_MAX_OPEN_CONNS draws on the same RAM. These are local-development numbers
# chosen against no hardware; a VPS deploy re-derives them.
ARGON2_MAX_CONCURRENT=2

# --- Object storage (R2) ----------------------------------------------------
# The bucket is where photographs live; the log carries an object id and never
# a URL. internal/config refuses to start without all nine of these, and
# S3_INTERNAL_ENDPOINT is set directly in the compose file rather than here
# because inside the network it is always `http://minio:9000`.

# WHAT A SIGNATURE COVERS, AND WHAT A PHONE CONNECTS TO (DEC-42). A SigV4
# signature covers the HOST, so a presigned URL minted against `minio:9000` is
# valid ONLY for a client that can resolve `minio` — a proxy cannot rewrite it,
# a Host header cannot correct it, a CNAME cannot rescue it, the signature
# simply fails. This is the address the phone and the browser will actually
# reach, and on a VPS or against real S3 it is the only line that changes.
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000

S3_REGION=us-east-1
S3_BUCKET=travellog-media

# The HOST port MinIO is published on. Loopback-bound. Change it freely — it is
# a fact about one machine, exactly as POSTGRES_PORT is — but change
# S3_PUBLIC_BASE_URL with it, or every signature is minted for a port nothing
# is listening on.
MINIO_PORT=9000

# The root credentials, and the API's S3 keys are the SAME PAIR: compose feeds
# MINIO_ROOT_USER/PASSWORD into both. Guessable for the same reason the
# Postgres pair is — the local-only target (DEC-21) — and a real deploy uses a
# scoped key rather than the root one. MinIO refuses a password under eight
# characters.
MINIO_ROOT_USER=travellog
MINIO_ROOT_PASSWORD=travellogsecret

# DEC-47's TWO LIFETIMES, and they are two variables because one number cannot
# be both.
#
# The PRIVATE one is the phone's own read (POST /v1/media/mint) and it is the
# revocation knob (DEC-44): the client re-fetches constantly and caches bytes
# by object id, so a short window costs it nothing.
#
# The PUBLIC one is what GET /l/{token} embeds. The envelope has nothing to
# re-mint its URLs with, so the private two minutes would make a shared page
# unreadable mid-scroll. RAISING IT IS A COPY CHANGE AND NOT A KNOB TURN
# (DEC-84): four client sentences are written against fifteen minutes, and the
# honest one is "stopping a share stops new links at once, and a photograph
# already loaded may keep working for up to fifteen minutes." Both are refused
# outside 1s..168h, which are minio-go's own limits — outside them every media
# route 500s at its first request.
S3_PRESIGN_TTL_PRIVATE=2m
S3_PRESIGN_TTL_PUBLIC=15m

# THE API-SIDE REFUSAL TO MINT, and it is NOT what the bucket enforces. SigV4
# signs an exact header value and never a range, so the bucket enforces
# `== the declared byteSize`; this is what stops a capability being minted for
# an absurd one in the first place. Both sentences are needed and neither is
# true alone.
#
# UNTUNED, like the three below it. 25 MiB is far above anything this system
# can currently produce — the fixture's larger photograph is 555,376 bytes and
# the client's shutter is inert by decision — and the API never buffers a byte
# of it, so a generous value costs bucket space rather than memory. Nothing in
# this plan reclaims an object; docs/BEFORE-A-PUBLIC-DEPLOY.md carries that.
MEDIA_MAX_BYTES=26214400

# --- Resource ceilings (DEC-95) ---------------------------------------------
# CEILINGS, NOT RESERVATIONS, so they deliberately sum to more than a 1 GiB box
# has. What they buy is that the OOM-killer's choice is yours rather than
# "whichever has the largest RSS" — which, after R2, is MinIO and not the API.
# Measured steady state: api 140.5 MiB after one Argon2 run (12.42 idle, and it
# does not come back down), minio 214.7 MiB idle, postgres at its default
# 128 MB shared_buffers. docs/BEFORE-A-PUBLIC-DEPLOY.md has the derivation.
API_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=384m
MINIO_MEM_LIMIT=512m

# --- Tests ------------------------------------------------------------------
# Not read by compose. internal/postgres tests SKIP when this is unset and say so,
# naming `make test-db` — so a green `go test ./...` with no database is an
# honest green rather than a silent one.
# TEST_DATABASE_URL=postgres://travellog:travellog@127.0.0.1:5434/travellog?sslmode=disable

# Not read by compose either, and read by a SECOND stack:
# deploy/docker-compose.test.yml, which `make test-s3` brings up on its own
# project name, its own port and its own volume so it can run beside `make up`.
# The internal/media integration legs are behind a build tag AS WELL AS behind
# this variable, so `go test ./...` never reaches them.
#
#   make test-s3
#   TEST_S3_ENDPOINT=... go test -tags integration ./internal/media/ -count=1
#
# TEST_S3_ENDPOINT=http://127.0.0.1:9412
# TEST_S3_ACCESS_KEY=travellog
# TEST_S3_SECRET_KEY=travellogsecret
