# Build output
/bin/
/out/

# Local environment. deploy/.env.example is checked in and is the documentation;
# deploy/.env is the developer's own and never is.
#
# ONLY deploy/.env IS READ BY COMPOSE. Compose's project directory is the
# directory holding the compose file — deploy/ — so a `.env` at the repository
# root is interpolated by NOTHING: no warning, no error, every variable falls
# back to its default and the stack comes up looking correct. Measured: a root
# .env with POSTGRES_PORT=6001 resolved `published: "5434"`; the same line in
# deploy/.env resolved `published: "6001"`.
#
# The bare `.env` line below is therefore NOT an invitation to put one there.
# It is kept — rather than dropped, which was the other option — because a
# stray root .env is exactly the file that must not reach the repository if
# somebody writes one anyway, and a git-ignored dud is better than a committed
# one. Both paths are excluded from the Docker build context too; see
# .dockerignore.
deploy/.env
.env

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Go test artefacts
*.test
*.out

# `go build ./...` — the literal first command of `make check` — writes the
# executable for the single main package into the CURRENT DIRECTORY, so a bare
# `make check` leaves ./api behind. Measured at VS1, caught by `git add -A`.
# The command is kept literal because the gate is specified as those four
# commands in that order; this line is the consequence.
/api

# `make backup` writes here. The dumps are the record and never the repository.
/backups/
